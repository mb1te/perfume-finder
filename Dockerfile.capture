FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/capture ./cmd/fragranticacapture

FROM alpine:3.23
RUN apk add --no-cache chromium ca-certificates
COPY --from=build /out/capture /capture
VOLUME ["/output"]
ENTRYPOINT ["/capture", "--output", "/output"]
